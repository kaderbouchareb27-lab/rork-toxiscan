{
  "expo": {
    "name": "Dr.Toxi",
    "slug": "toxis",
    "version": "6.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.7x6ujs5cfo0x23gzhbn3e",
      "infoPlist": {
        "NSCameraUsageDescription": "Dr.Toxi utilise votre appareil photo pour scanner les codes-barres et photographier les listes d'ingrédients de vos produits afin d'identifier les substances potentiellement dangereuses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.7x6ujs5cfo0x23gzhbn3e",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dr.Toxi utilise votre appareil photo pour scanner les codes-barres et photographier les listes d'ingrédients de vos produits afin d'identifier les substances potentiellement dangereuses."
        }
      ],
      "react-native-purchases",
      "expo-font",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}