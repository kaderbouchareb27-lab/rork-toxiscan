{
  "expo": {
    "name": "ToxiScan",
    "slug": "toxis",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "kader1316",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.toxis",
      "buildNumber": "24",
      "infoPlist": {
        "NSCameraUsageDescription": "ToxiScan utilise la caméra pour photographier les étiquettes de vos produits et analyser leurs ingrédients.",
        "NSMicrophoneUsageDescription": "Dr. Toxi a besoin du microphone pour t'écouter quand tu lui poses des questions vocales sur tes produits.",
        "NSSpeechRecognitionUsageDescription": "Dr. Toxi utilise la reconnaissance vocale pour transcrire tes questions vocales sur tes produits."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.toxis",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "66ac4927-f9db-4d22-8876-3b6a51e3d03b"
      }
    }
  }
}